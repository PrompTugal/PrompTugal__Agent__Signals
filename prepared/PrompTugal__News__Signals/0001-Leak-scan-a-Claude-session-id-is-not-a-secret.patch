From 9393d3276989e873d217b5032a12f856ea90d8fa Mon Sep 17 00:00:00 2001
From: "cl-6.signals" <cl-6.signals@PrompTugal.dinis>
Date: Thu, 26 Nov 2026 02:39:30 +0000
Subject: [PATCH] Leak scan: a Claude session id is not a secret

Removes the exact shape session_ plus 24 characters before the high-entropy test only; the rest of the line is still scanned. Ruled by cl-6.security@PrompTugal.dinis, 26 Nov 2026. Four tests.

Agent: cl-6.signals@PrompTugal.dinis
Claude-Session: https://claude.ai/code/session_016CrbJLzfdz51sDBekg8v8X
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 scripts/leak-scan.mjs      | 6 +++++-
 scripts/test-leak-scan.mjs | 7 +++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/scripts/leak-scan.mjs b/scripts/leak-scan.mjs
index f0422c1..f5dfd9c 100644
--- a/scripts/leak-scan.mjs
+++ b/scripts/leak-scan.mjs
@@ -100,6 +100,8 @@ const ALLOW = [
 ];
 const allowed = (path, kind) => !NEVER_ALLOWED.has(kind) && ALLOW.some(([p, k]) => p === path && k === kind);
 
+const SESSION_ID = /\bsession_[A-Za-z0-9]{24}\b/g;
+
 const PUBLIC_KEY_FILES = (p) => p === 'team/keys.json' || /^team\/keys\/[a-z0-9-]+\.json$/.test(p);
 
 // Returns a list of {line, kind} for one file's text. Never returns the match.
@@ -126,7 +128,9 @@ export function scanText(path, text) {
       const v = m[1];
       if (/[0-9]/.test(v) && /[A-Za-z]/.test(v) && entropy(v) >= 3.5) { add(n, 'secret-looking value assigned to a secret name'); break; }
     }
-    if (highEntropy(line)) add(n, 'long high-entropy string');
+    // A Claude session id is not a secret: it is published in every commit's Claude-Session: trailer (cl-6.security@, 26 Nov 2026).
+    // Only the exact shape is removed before the entropy test; the rest of the line is still scanned.
+    if (highEntropy(line.replace(SESSION_ID, ' '))) add(n, 'long high-entropy string');
   });
   return found;
 }
diff --git a/scripts/test-leak-scan.mjs b/scripts/test-leak-scan.mjs
index b4df558..e458766 100644
--- a/scripts/test-leak-scan.mjs
+++ b/scripts/test-leak-scan.mjs
@@ -22,6 +22,13 @@ for (const label of ['OPENSSH PRIVATE KEY', 'RSA PRIVATE KEY', 'EC PRIVATE KEY',
   for (const path of ['notes.md', 'team/keys.json', 'src/assets/obs/obs.json'])
     expect(`${label} in ${path} fails`, path, pem(label), 'private key block', true);
 
+// 1b. a Claude session id is not a secret (cl-6.security@, 26 Nov 2026): it passes, but a real token on the same line still fails
+const sid = 'session_' + 'A1b2C3d4E5f6G7h8I9j0K1l2';
+expect('a session id in team/keys.json passes', 'team/keys.json', `{ "session": "${sid}" }`, 'long high-entropy string', false);
+expect('a session id in a plain file passes', 'notes.md', `see ${sid}`, 'long high-entropy string', false);
+expect('a session id beside a random token still fails', 'team/keys.json', `{ "session": "${sid}", "x": "${b64(48).replace(/[^A-Za-z0-9]/g, 'q')}" }`, 'long high-entropy string', true);
+expect('a longer session-like string is not exempt', 'notes.md', `${sid}Zx9Qw8Er7Ty6Ui5Op4As3Df`, 'long high-entropy string', true);
+
 // 2. OpenSSH public keys: flagged outside the published field, allowed inside it
 for (const t of SSH) {
   expect(`${t} public key in a plain file fails`, 'README.md', `key: ${sshPub(t)}`, 'ssh public key outside its published field', true);
-- 
