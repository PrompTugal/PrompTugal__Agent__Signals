 set -euo pipefail
 cd "$(dirname "$0")/.."
 # Refuse during a hold (finding 3), with uncommitted changes (finding 4: the gates must check what is
@@ -19,9 +19,14 @@ node scripts/test-check-signatures.mjs
 scripts/test-deciding-step.sh
 node scripts/check-signatures.mjs origin/dev HEAD   # this tree's check, as a test of it
