-  git fetch -q origin dev
-  git rebase -q origin/dev
+# With the dev-gate on: the FINAL release recipe (cl-6.conductor, agreed by cl-6.infra and cl-6.security@, 27 Nov 2026; IaC #35).
+# The release commit is already signed on top of origin/dev. Plain push to work/<agent>, never force, never dev or main; the gate
+# fast-forwards dev to it. A tag gate/<agent>/<sha12>-fail means the gate refused it: stop and report. Only if the push is
+# refused as a non-fast-forward (something else moved dev, or an earlier release left a work head): merge origin/dev (and that
+# head) into this branch with a signed merge commit, run every gate again, push again. Undo a refused commit with a signed
+# revert; history is never rewritten.
+AGENT_NAME=cl-6.signals   # hard-coded, never from the environment
+gates() {
   # One gate per line: under set -e a failure inside an && chain does not stop the script (specialist.code@ finding 1).
   node scripts/build.mjs >/dev/null
   node scripts/validate.mjs >/dev/null
@@ -29,7 +34,25 @@ for i in 1 2 3 4 5; do
   node scripts/check-commits.mjs origin/dev HEAD >/dev/null
   node scripts/check-signatures.mjs origin/dev HEAD >/dev/null
   scripts/check-signatures-trusted.sh origin/dev origin/dev HEAD >/dev/null
-  if git -c push.negotiate=true push -q origin HEAD:dev; then echo "released $(git rev-parse --short HEAD) to dev"; exit 0; fi
-  sleep $((i * 3))
+}
+pushed=no
+for i in 1 2 3 4 5; do
+  if git -c push.negotiate=true push -q origin "HEAD:refs/heads/work/${AGENT_NAME}"; then pushed=yes; break; fi
+  # refused as a non-fast-forward: merge, never rebase
+  git fetch -q origin dev
+  git merge-base --is-ancestor origin/dev HEAD || git merge --no-edit -S origin/dev
+  if [ -n "$(git ls-remote origin "refs/heads/work/${AGENT_NAME}" | cut -f1)" ]; then
+    git fetch -q origin "refs/heads/work/${AGENT_NAME}:refs/remotes/origin/work/${AGENT_NAME}"
+    git merge-base --is-ancestor "origin/work/${AGENT_NAME}" HEAD || git merge --no-edit -S "origin/work/${AGENT_NAME}"
+  fi
+  gates
+done
+[ "$pushed" = yes ] || { echo "work/${AGENT_NAME} was refused after 5 rounds: stop and report" >&2; exit 1; }
+sha=$(git rev-parse HEAD)
+# up to about 20 minutes, a look every 90 seconds
+for w in $(seq 1 13); do
+  sleep 90
+  if [ "$(git ls-remote origin refs/heads/dev | cut -f1)" = "$sha" ]; then echo "released ${sha:0:7} to dev"; exit 0; fi
+  if git ls-remote --tags origin "refs/tags/gate/${AGENT_NAME}/${sha:0:12}-fail" | grep -q .; then echo "the gate refused ${sha:0:12} (tag gate/${AGENT_NAME}/${sha:0:12}-fail): stop and report" >&2; exit 1; fi
 done
-echo "release failed after 5 attempts" >&2; exit 1
